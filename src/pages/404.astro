---
import BaseLayout from '../layouts/BaseLayout.astro';
import LucideIcon from '../components/LucideIcon.astro';
import { metadata } from '../data/site';
const meta = {
  ...metadata.login,
  title: '页面未找到 - Voidix',
  description: '抱歉，您访问的页面不存在。返回Voidix首页探索更多精彩内容。',
  noindex: true,
};
---

<BaseLayout meta={meta} path="/404">
  <section
    class="flex min-h-screen items-center justify-center bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 px-4"
  >
    <div class="mx-auto max-w-2xl text-center">
      <header class="mb-8">
        <h1
          class="animate-pulse bg-gradient-to-r from-purple-400 via-cyan-400 to-blue-400 bg-clip-text text-8xl font-bold text-transparent md:text-9xl"
        >
          404
        </h1><p class="mt-4 text-2xl font-semibold text-gray-300 md:text-3xl">页面走丢了</p>
      </header>
      <div class="mb-8 space-y-4">
        <p class="text-lg text-gray-300">抱歉，您访问的页面不存在或已被移动。</p><p class="text-gray-300">
          可能是链接错误，或者页面已经不存在了。
        </p>
      </div>
      <aside class="mb-8 rounded-xl border border-gray-700 bg-gray-800/50 p-6 text-left backdrop-blur-sm">
        <h2 class="mb-4 text-xl font-semibold text-white">您可以尝试：</h2><ul class="space-y-2 text-gray-300">
          <li class="flex items-center">
            <i class="mr-3 h-2 w-2 rounded-full bg-purple-400"></i>检查URL地址是否正确
          </li><li class="flex items-center">
            <i class="mr-3 h-2 w-2 rounded-full bg-cyan-400"></i>返回首页重新导航
          </li><li class="flex items-center">
            <i class="mr-3 h-2 w-2 rounded-full bg-blue-400"></i>使用搜索功能查找内容
          </li>
        </ul>
      </aside>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/"
          class="inline-flex items-center rounded-lg bg-gradient-to-r from-blue-500 to-purple-600 px-6 py-3 text-lg font-medium text-white transition-colors hover:from-blue-600 hover:to-purple-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-gray-900"
          ><LucideIcon name="home" class="mr-2 h-5 w-5" />返回首页</a
        ><button
          class="inline-flex items-center rounded-lg bg-gray-600 px-6 py-3 text-lg font-medium text-white transition-colors hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 focus:ring-offset-gray-900"
          data-go-back
          ><svg
            class="mr-2 h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7"></path></svg
          >返回上页</button
        ><a
          href="/faq/"
          class="inline-flex items-center rounded-lg border border-gray-600 px-6 py-3 text-lg font-medium text-gray-300 transition-colors hover:bg-gray-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 focus:ring-offset-gray-900"
          ><LucideIcon name="search" class="mr-2 h-5 w-5" />常见问题</a
        >
      </div>
      <p class="mt-12 text-sm text-gray-500">如果问题持续存在，请联系我们的技术支持团队</p>
    </div>
  </section>
  <script>
    document.querySelector('[data-go-back]')?.addEventListener('click', () => {
      if (history.length > 1) history.back();
      else location.href = '/';
    });
  </script>
</BaseLayout>
