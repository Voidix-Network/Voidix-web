---
interface Props {
  current: string;
  currentHref?: string;
  class?: string;
}

const { current, currentHref, class: className = '' } = Astro.props;
---

<nav aria-label="面包屑导航" class:list={['flex items-center space-x-2 text-sm', className]}>
  <ol class="flex items-center space-x-2">
    <li class="flex items-center space-x-2">
      <a href="/" class="flex items-center space-x-1 text-gray-300 transition-colors hover:text-white">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          ><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path><path d="M9 22V12h6v10"></path></svg
        >
        <span>首页</span>
      </a>
      <svg
        class="h-4 w-4 text-gray-300"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg
      >
    </li>
    <li>
      {
        currentHref ? (
          <a href={currentHref} class="text-gray-300 transition-colors hover:text-white">
            {current}
          </a>
        ) : (
          <span class="font-medium text-white" aria-current="page">
            {current}
          </span>
        )
      }
    </li>
  </ol>
</nav>
