---
import LucideIcon from '../LucideIcon.astro';

const servers = [
  {
    name: '小游戏服务器',
    address: 'minigame.voidix.net',
    description: '我们有起床战争等玩法，更多玩法正在持续更新中！',
    icon: 'trophy' as const,
    iconClass: 'text-[#a6b8ff]',
    features: ['支持 26.1-26.1.2', '尽最大努力的优化', '多种玩法可选择'],
  },
  {
    name: '生存服务器',
    address: 'survival.voidix.net',
    description: '没有花里胡哨的特效，没有乱糟糟的界面，只有最纯净的生存',
    icon: 'mountain' as const,
    iconClass: 'text-green-400',
    features: ['极致的性能', '超纯净生存', '装有回档保护'],
  },
];
---

<section class="px-5 py-16 sm:px-6 sm:py-24" id="servers">
  <div class="mx-auto max-w-6xl border-t border-white/10 pt-12 sm:pt-20">
    <div class="max-w-2xl">
      <h2 class="text-[42px] font-semibold leading-[1.1] text-white" data-motion="fade-up">先选一个玩法</h2>
      <p class="mt-5 text-[17px] leading-7 text-gray-400" data-motion="fade-up" style="--motion-delay: 80ms">
        两个服务器，都是免费加入，也都没有付费优势。
      </p>
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-2 md:gap-16">
      {
        servers.map((server, index) => (
          <article
            class="border-t border-white/10 pt-6"
            data-motion="fade-up"
            style={`--motion-delay: ${index * 100}ms`}
          >
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <LucideIcon name={server.icon} class:list={['h-5 w-5', server.iconClass]} />
                <h3 class="text-xl font-medium text-white">{server.name}</h3>
              </div>
              <LucideIcon name="external-link" class="h-4 w-4 text-gray-600" />
            </div>
            <p class:list={['mt-5 font-mono text-sm', server.iconClass]}>{server.address}</p>
            <p class="mt-4 max-w-md text-[15px] leading-7 text-gray-400">{server.description}</p>
            <ul class="mt-7 space-y-3">
              {server.features.map((feature) => (
                <li class="flex items-center gap-3 text-sm text-gray-300">
                  <LucideIcon name="check" class="h-4 w-4 flex-shrink-0 text-gray-500" />
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
