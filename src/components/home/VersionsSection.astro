---
import LucideIcon from '../LucideIcon.astro';

const javaSteps = ['启动Minecraft Java版', '点击"多人游戏"', '点击"添加服务器"', '点击"完成"并加入服务器'];
const bedrockSteps = [
  '启动Minecraft基岩版 (Windows 10/11, Mobile, Xbox, PS, Switch)',
  '点击"游戏" → "服务器"选项卡',
  '滚动到底部，点击"添加服务器"',
  '点击"保存"，然后在服务器列表中找到并加入Voidix',
];
---

<section class="px-5 py-16 sm:px-6 sm:py-24" id="versions">
  <div class="mx-auto max-w-6xl border-t border-white/10 pt-12 sm:pt-20">
    <div class="max-w-2xl">
      <h2 class="text-[42px] font-semibold leading-[1.1] text-white" data-motion="fade-up">怎么加入</h2>
      <p class="mt-5 text-[17px] leading-7 text-gray-400" data-motion="fade-up" style="--motion-delay: 80ms">
        按你的设备选择一个标签，照着做就能进服。两个服务器的地址都在下面。
      </p>
    </div>

    <div
      class="mt-12 overflow-hidden rounded-lg border border-white/10 bg-[#111113]"
      data-motion="fade-up"
      style="--motion-delay: 160ms"
    >
      <div class="relative flex border-b border-white/10" role="tablist" aria-label="连接平台">
        <button
          class="tab-btn px-5 py-4 text-sm font-medium text-white sm:px-6"
          data-version-tab="0"
          type="button"
          role="tab"
          aria-selected="true">Java版连接</button
        >
        <button
          class="tab-btn px-5 py-4 text-sm font-medium text-gray-500 transition-colors hover:text-white sm:px-6"
          data-version-tab="1"
          type="button"
          role="tab"
          aria-selected="false">基岩版连接</button
        >
        <div class="absolute bottom-0 h-px bg-[#6a93ff] transition-all duration-200" data-version-underline></div>
      </div>

      <div class="relative overflow-hidden transition-[height] duration-200" data-version-container>
        <div class="flex transition-transform duration-200" data-version-slider>
          <div class="w-full flex-shrink-0" data-version-panel role="tabpanel">
            <div class="p-6 sm:p-8">
              <div class="flex items-center gap-4">
                <LucideIcon name="monitor" class="h-5 w-5 text-[#a6b8ff]" />
                <div>
                  <h3 class="text-lg font-medium text-white">Java版玩家连接指南</h3>
                  <p class="mt-1 text-sm text-gray-500">适用于PC端Minecraft Java版</p>
                </div>
              </div>
              <ol class="mt-7 divide-y divide-white/10 border-y border-white/10">
                {
                  javaSteps.slice(0, 3).map((step, index) => (
                    <li class="flex gap-5 py-4 text-sm text-gray-300">
                      <>
                        <span class="w-4 text-[#a6b8ff]">{index + 1}</span>
                        <span>{step}</span>
                      </>
                    </li>
                  ))
                }
                <li class="flex gap-5 py-4 text-sm text-gray-300">
                  <span class="w-4 text-[#a6b8ff]">4</span>
                  <div>
                    <span>输入服务器地址：</span><div class="mt-3 flex flex-wrap gap-2 font-mono text-xs text-white">
                      <span class="rounded-md bg-white/5 px-3 py-2">minigame.voidix.net</span><span
                        class="rounded-md bg-white/5 px-3 py-2">survival.voidix.net</span
                      >
                    </div>
                  </div>
                </li>
                <li class="flex gap-5 py-4 text-sm text-gray-300">
                  <span class="w-4 text-[#a6b8ff]">5</span><span>{javaSteps[3]}</span>
                </li>
              </ol>
            </div>
          </div>

          <div class="w-full flex-shrink-0" data-version-panel role="tabpanel">
            <div class="p-6 sm:p-8">
              <div class="flex items-center gap-4">
                <LucideIcon name="smartphone" class="h-5 w-5 text-green-400" />
                <div>
                  <h3 class="text-lg font-medium text-white">基岩版玩家连接指南</h3>
                  <p class="mt-1 text-sm text-gray-500">
                    启动Minecraft基岩版 (Windows 10/11, Mobile, Xbox, PS, Switch)
                  </p>
                </div>
              </div>
              <ol class="mt-7 divide-y divide-white/10 border-y border-white/10">
                {
                  bedrockSteps.slice(0, 3).map((step, index) => (
                    <li class="flex gap-5 py-4 text-sm text-gray-300">
                      <>
                        <span class="w-4 text-green-400">{index + 1}</span>
                        <span>{step}</span>
                      </>
                    </li>
                  ))
                }
                <li class="flex gap-5 py-4 text-sm text-gray-300">
                  <span class="w-4 text-green-400">4</span>
                  <div class="space-y-2">
                    <span>输入以下信息：</span><div class="space-y-2 text-xs">
                      <div>
                        <span class="text-gray-500">服务器名称：</span><span class="font-medium text-white">Voidix</span
                        ><span class="text-gray-500">（任意）</span>
                      </div><div class="flex flex-wrap gap-2">
                        <span class="text-gray-500">服务器地址：</span><span class="font-mono text-white"
                          >minigame.voidix.net</span
                        ><span class="text-gray-500">或</span><span class="font-mono text-white"
                          >survival.voidix.net</span
                        >
                      </div><div>
                        <span class="text-gray-500">端口：</span><span class="font-mono text-white">10205</span>
                      </div>
                    </div>
                  </div>
                </li>
                <li class="flex gap-5 py-4 text-sm text-gray-300">
                  <span class="w-4 text-green-400">5</span><span>{bedrockSteps[3]}</span>
                </li>
              </ol>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
