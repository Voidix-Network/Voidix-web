---
import LucideIcon from '../LucideIcon.astro';
import { team } from '../../data/site';

const rules = [
  {
    icon: 'shield' as const,
    title: '禁止作弊',
    description: '作弊会破坏其他玩家的游戏体验，我们致力于维护公平的游戏环境',
    color: 'text-red-300',
  },
  {
    icon: 'users' as const,
    title: '和谐交流',
    description: '请勿攻击他人，维护Voidix的社区环境需要我们共同努力',
    color: 'text-[#a6b8ff]',
  },
  {
    icon: 'bug' as const,
    title: '禁止恶意使用游戏bug',
    description: '好玩的bug可以使游戏更欢乐——利用恶意bug则会破坏游戏公平性',
    color: 'text-orange-300',
  },
  {
    icon: 'home' as const,
    title: '尊重他人建筑',
    description: '未经允许请勿破坏或修改其他玩家的建筑作品',
    color: 'text-green-300',
  },
];
---

<section class="px-5 py-16 sm:px-6 sm:py-24" id="team">
  <div class="mx-auto max-w-6xl border-t border-white/10 pt-12 sm:pt-20">
    <div class="max-w-2xl" data-motion="fade-up">
      <h2 class="text-[42px] font-semibold leading-[1.1] text-white">谁在维护这里</h2>
      <p class="mt-5 text-[17px] leading-7 text-gray-400">这是一个小团队，也有玩家一起帮忙测试、提建议和维护社区。</p>
    </div>

    <div class="mt-12 grid gap-x-12 md:grid-cols-2">
      {
        team.map((member, index) => (
          <article
            class="border-t border-white/10 py-6"
            data-motion="fade-up"
            style={`--motion-delay: ${index * 60}ms`}
          >
            <div class="flex gap-4">
              {member.avatar ? (
                <img
                  src={`/avatars/${member.avatar}.png`}
                  width="56"
                  height="56"
                  alt={`${member.name}的Minecraft头像`}
                  class="h-14 w-14 flex-shrink-0 rounded-lg object-cover"
                  style="image-rendering: pixelated;"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-lg bg-white/5 text-sm font-medium text-[#a6b8ff]">
                  玩家
                </div>
              )}
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                  <h3 class="text-lg font-medium text-white">{member.name}</h3>
                  {member.aka?.length && <span class="text-xs text-gray-500">({member.aka.join(' / ')})</span>}
                </div>
                <p class="mt-1 text-sm text-[#a6b8ff]">{member.role}</p>
                <p class="mt-3 text-[15px] leading-6 text-gray-400">{member.description}</p>
                {member.contributions.length > 0 && (
                  <details class="group mt-4">
                    <summary class="cursor-pointer text-sm text-gray-300 marker:hidden transition-colors hover:text-white">
                      查看主要贡献 <span class="ml-1 text-gray-500 group-open:hidden">+</span>
                      <span class="ml-1 text-gray-500 hidden group-open:inline">-</span>
                    </summary>
                    <ul class="mt-4 space-y-2 border-l border-white/10 pl-4 text-sm leading-6 text-gray-400">
                      {member.contributions.map((contribution) => (
                        <li>{contribution}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <details class="group mt-12 border-y border-white/10" data-covenant data-motion="fade-up">
      <summary class="flex cursor-pointer list-none items-center justify-between py-6">
        <div>
          <h3 class="text-xl font-medium text-white">玩家公约</h3>
          <p class="mt-2 text-sm text-gray-500">Voidix社区行为准则</p>
        </div>
        <LucideIcon name="chevron-down" class="h-5 w-5 text-gray-500 transition-transform group-open:rotate-180" />
      </summary>
      <div class="border-t border-white/10 py-6">
        <div class="grid gap-6 sm:grid-cols-2">
          {
            rules.map((rule, index) => (
              <div class="flex gap-3" data-covenant-rule>
                <LucideIcon name={rule.icon} class:list={['mt-1 h-4 w-4 flex-shrink-0', rule.color]} />
                <div>
                  <h4 class="text-sm font-medium text-gray-200">
                    {index + 1}. {rule.title}
                  </h4>
                  <p class="mt-2 text-sm leading-6 text-gray-500">{rule.description}</p>
                </div>
              </div>
            ))
          }
        </div>
        <a
          href="https://docs.qq.com/doc/DU0dGc2dwU2VaWUpm"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-[#a6b8ff] transition-colors hover:text-white"
          data-covenant-link
        >
          查看完整玩家规则
          <LucideIcon name="external-link" class="h-4 w-4" />
        </a>
        <div class="mt-6 flex gap-3 border-t border-white/10 pt-6" data-covenant-notice>
          <LucideIcon name="alert-triangle" class="mt-1 h-4 w-4 flex-shrink-0 text-amber-300" />
          <p class="text-sm leading-6 text-gray-500">
            违反服务器规则可能导致警告、暂时封禁或永久封禁。如果您对处罚有异议，可以通过渠道进行申诉。
          </p>
        </div>
      </div>
    </details>
  </div>
</section>
