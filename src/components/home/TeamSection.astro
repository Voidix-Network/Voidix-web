---
import LucideIcon from '../LucideIcon.astro';
import { team } from '../../data/site';

const visuals = [
  {
    gradientFrom: 'from-violet-900/40',
    gradientTo: 'to-purple-900/40',
    role: 'text-violet-400',
    text: 'text-violet-400',
    abbreviation: 'Neko',
  },
  {
    gradientFrom: 'from-indigo-900/40',
    gradientTo: 'to-blue-900/40',
    role: 'text-indigo-400',
    text: 'text-indigo-400',
    abbreviation: 'cyh',
  },
  {
    gradientFrom: 'from-purple-900/40',
    gradientTo: 'to-fuchsia-900/40',
    role: 'text-fuchsia-400',
    text: 'text-fuchsia-400',
    abbreviation: 'Almost',
  },
  {
    gradientFrom: 'from-purple-900/40',
    gradientTo: 'to-blue-900/40',
    role: 'text-blue-400',
    text: 'text-blue-400',
    abbreviation: 'ASKLL',
  },
  {
    gradientFrom: 'from-blue-900/40',
    gradientTo: 'to-indigo-900/70',
    role: 'text-blue-400',
    text: 'text-blue-400',
    abbreviation: 'Momoi',
  },
  {
    gradientFrom: 'from-slate-900/40',
    gradientTo: 'to-blue-900/40',
    role: 'text-slate-400',
    text: 'text-slate-400',
    abbreviation: 'Player',
  },
];

const rules = [
  {
    icon: 'shield' as const,
    title: '禁止作弊',
    description: '作弊会破坏其他玩家的游戏体验，我们致力于维护公平的游戏环境',
    color: 'from-red-500 to-pink-500',
  },
  {
    icon: 'users' as const,
    title: '和谐交流',
    description: '请勿攻击他人，维护Voidix的社区环境需要我们共同努力',
    color: 'from-blue-500 to-cyan-500',
  },
  {
    icon: 'bug' as const,
    title: '禁止恶意使用游戏bug',
    description: '好玩的bug可以使游戏更欢乐——利用恶意bug则会破坏游戏公平性',
    color: 'from-orange-500 to-yellow-500',
  },
  {
    icon: 'home' as const,
    title: '尊重他人建筑',
    description: '未经允许请勿破坏或修改其他玩家的建筑作品',
    color: 'from-green-500 to-emerald-500',
  },
];
---

<section class="py-20 px-4 sm:px-6 lg:px-8" id="team" data-motion="fade-up" data-motion-team>
  <div class="mx-auto max-w-7xl">
    <div
      class="mb-16 text-center"
      data-motion="fade-up"
      data-motion-eager
      data-motion-no-mobile
      style="--motion-duration: 600ms"
    >
      <h2 class="mb-4 text-3xl font-bold">我们的 <span class="gradient-text font-bold font-sans">团队</span></h2>
      <p class="mx-auto max-w-2xl text-gray-300">
        这些热爱Minecraft的开发者/管理员——与热爱游戏的你们，撑起了整个Voidix
      </p>
    </div>

    <div class="mb-16 grid items-start gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        team.map((member, index) => {
          const visual = visuals[index];
          const hasContributions = member.contributions.length > 0;
          return (
            <div class="h-full">
              <div
                class="relative h-96 cursor-pointer overflow-hidden rounded-2xl border border-gray-700 bg-gray-800/50 backdrop-blur-sm transition-all duration-300"
                data-team-card={hasContributions ? '' : undefined}
                data-motion="fade-up"
                data-motion-eager
                data-motion-no-mobile
                style={`--motion-delay: ${index * 100}ms; --motion-duration: 600ms`}
              >
                <div class="absolute inset-0 flex flex-col" data-team-front>
                  <div
                    class:list={[
                      'relative flex h-64 items-center justify-center bg-gradient-to-br',
                      visual.gradientFrom,
                      visual.gradientTo,
                    ]}
                  >
                    <div class="absolute inset-0 bg-gradient-to-br from-gray-900/20 to-slate-900/10" />
                    <div class:list={['relative text-6xl font-bold', `${visual.text}/50`]}>{visual.abbreviation}</div>
                    {hasContributions && (
                      <div class="absolute right-4 top-4 opacity-60 transition-opacity group-hover:opacity-100">
                        <div class="rounded-full bg-black/50 p-2 backdrop-blur-sm">
                          <LucideIcon name="info" class="h-4 w-4 text-white" />
                        </div>
                      </div>
                    )}
                  </div>

                  <div class="flex h-32 flex-col p-6">
                    <h3 class="mb-1 text-xl font-bold">{member.name}</h3>
                    <div class:list={[visual.role, 'mb-2 text-sm']}>{member.role}</div>
                    <p class="flex-1 line-clamp-3 text-sm text-gray-400">{member.description}</p>
                    {hasContributions && (
                      <div class="mt-2 text-center">
                        <span class="text-xs text-gray-500" data-team-hint>
                          悬停查看贡献
                        </span>
                      </div>
                    )}
                  </div>
                </div>

                <div
                  class="absolute inset-0 flex flex-col rounded-2xl border border-purple-500/50 bg-gray-900/95"
                  data-team-back
                  aria-hidden="true"
                >
                  <div class="flex h-full flex-col p-6">
                    <div class="mb-4 flex items-center gap-3">
                      {member.avatar ? (
                        <div class="relative h-12 w-12 overflow-hidden rounded-lg" data-team-avatar>
                          <div
                            class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-gray-600 to-gray-700 font-bold text-white"
                            data-team-avatar-loading
                          >
                            {visual.abbreviation}
                          </div>
                          <img
                            src={`/avatars/${member.avatar}.png`}
                            width="48"
                            height="48"
                            alt={`${member.avatar}的Minecraft头像`}
                            class="h-full w-full object-cover opacity-0 transition-opacity duration-300"
                            style="image-rendering: pixelated; filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));"
                            loading="lazy"
                            data-team-avatar-image
                          />
                        </div>
                      ) : (
                        <div
                          class:list={[
                            'flex h-12 w-12 items-center justify-center rounded-lg bg-gradient-to-br',
                            visual.gradientFrom,
                            visual.gradientTo,
                          ]}
                        >
                          <div class:list={['text-lg font-bold', visual.text]}>{visual.abbreviation}</div>
                        </div>
                      )}
                      <div>
                        <div class="flex items-baseline gap-2">
                          <h3 class="text-lg font-bold">{member.name}</h3>
                          {member.aka?.length && (
                            <span class="text-xs font-normal text-gray-500">({member.aka.join(' / ')})</span>
                          )}
                        </div>
                        <div class:list={[visual.role, 'text-xs']}>{member.role}</div>
                      </div>
                    </div>

                    {hasContributions && (
                      <div class="flex-1 overflow-y-auto">
                        <h4 class="mb-3 text-sm font-bold text-purple-300">主要贡献</h4>
                        <ul class="space-y-2">
                          {member.contributions.map((contribution, contributionIndex) => (
                            <li
                              class="flex items-start gap-2 text-xs"
                              data-team-contribution
                              style={`--contribution-delay: ${contributionIndex * 50}ms`}
                            >
                              <LucideIcon name="check" class:list={['mt-0.5 h-3 w-3 flex-shrink-0', visual.role]} />
                              <span class="leading-relaxed text-gray-200">{contribution}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}

                    <div class="mt-4 border-t border-gray-700 pt-3 text-center">
                      <span class="text-xs text-gray-400" data-team-return>
                        移开鼠标返回
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <div
      class="relative mx-auto max-w-4xl"
      data-covenant
      data-motion="fade-up"
      data-motion-eager
      data-motion-no-mobile
      style="--motion-duration: 600ms"
    >
      <div
        class="absolute inset-0 rounded-3xl bg-gradient-to-br from-purple-900/20 via-indigo-900/20 to-blue-900/20 blur-sm"
      >
      </div>
      <div class="relative overflow-hidden rounded-3xl border border-gray-700/50 bg-gray-800/80 backdrop-blur-sm">
        <button
          class="group flex w-full items-center justify-between px-8 py-6 text-left transition-all duration-300 hover:bg-gray-700/30"
          type="button"
          data-covenant-button
        >
          <div class="flex items-center gap-4">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-purple-600 to-indigo-600 shadow-lg"
            >
              <LucideIcon name="shield" class="h-6 w-6 text-white" />
            </div>
            <div>
              <h3
                class="bg-gradient-to-r from-purple-400 to-indigo-400 bg-clip-text text-xl font-bold text-transparent"
              >
                玩家公约
              </h3>
              <p class="mt-1 text-sm text-gray-300">Voidix社区行为准则</p>
            </div>
          </div>
          <div class="text-purple-400 group-hover:text-purple-300" data-covenant-chevron>
            <LucideIcon name="chevron-down" class="h-6 w-6" />
          </div>
        </button>

        <div class="overflow-hidden" data-covenant-content>
          <div class="px-8 pb-8">
            <div class="mb-8 mt-6 grid gap-6">
              {
                rules.map((rule, index) => (
                  <div
                    class="group flex items-start gap-4 rounded-2xl border border-gray-700/50 bg-gray-900/40 p-4 transition-all duration-300 hover:border-gray-600/50 hover:bg-gray-900/60"
                    data-covenant-rule
                    style={`--covenant-delay: ${index * 100}ms`}
                  >
                    <div
                      class:list={[
                        'flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br shadow-lg transition-transform duration-300 group-hover:scale-110',
                        rule.color,
                      ]}
                    >
                      <LucideIcon name={rule.icon} class="h-5 w-5 text-white" />
                    </div>
                    <div class="min-w-0 flex-1">
                      <>
                        <h4 class="mb-2 font-bold text-gray-200 transition-colors group-hover:text-white">
                          {index + 1}. {rule.title}
                        </h4>
                        <p class="text-sm leading-relaxed text-gray-400 transition-colors group-hover:text-gray-300">
                          {rule.description}
                        </p>
                      </>
                    </div>
                  </div>
                ))
              }
            </div>

            <div class="mb-6" data-covenant-link>
              <a
                href="https://docs.qq.com/doc/DU0dGc2dwU2VaWUpm"
                target="_blank"
                rel="noopener noreferrer"
                class="group block w-full rounded-2xl border border-purple-500/30 bg-gradient-to-r from-purple-600/20 to-indigo-600/20 p-4 transition-all duration-300 hover:scale-[1.02] hover:border-purple-400/50 hover:from-purple-600/30 hover:to-indigo-600/30"
              >
                <div class="flex w-full items-center justify-between">
                  <div class="flex flex-1 items-center gap-3">
                    <div
                      class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-purple-500 to-indigo-500"
                    >
                      <LucideIcon name="external-link" class="h-4 w-4 text-white" />
                    </div><div class="text-left">
                      <h4 class="font-bold text-purple-300 transition-colors group-hover:text-purple-200">
                        查看完整玩家规则
                      </h4><p class="mt-1 text-xs text-gray-400 transition-colors group-hover:text-gray-300">
                        点击查看详细的服务器规则和管理条例
                      </p>
                    </div>
                  </div>
                  <div
                    class="ml-3 text-purple-400 transition-transform group-hover:translate-x-[3px] group-hover:text-purple-300"
                  >
                    <LucideIcon name="external-link" class="h-5 w-5" />
                  </div>
                </div>
              </a>
            </div>

            <div
              class="relative rounded-2xl border border-amber-500/20 bg-gradient-to-br from-amber-900/20 to-orange-900/20 p-6"
              data-covenant-notice
            >
              <div class="flex items-start gap-4">
                <div
                  class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-amber-500 to-orange-500"
                >
                  <LucideIcon name="alert-triangle" class="h-4 w-4 text-white" />
                </div><div class="flex-1">
                  <h5 class="mb-2 font-bold text-amber-300">重要提醒</h5><p
                    class="text-sm leading-relaxed text-amber-100/80"
                  >
                    违反服务器规则可能导致警告、暂时封禁或永久封禁。如果您对处罚有异议，可以通过渠道进行申诉。
                  </p>
                </div>
              </div>
              <div
                class="absolute right-0 top-0 h-24 w-24 rounded-full bg-gradient-to-br from-amber-500/10 to-transparent blur-xl"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
