---
const events = [
  [
    '2022年7月16日',
    'VBPIXEL成立',
    'VBPIXEL 开始运营。两年里，陆续有 110 多名玩家加入。后来服务器的问题越来越多，只靠 Neko 一个人已经很难继续维护。',
  ],
  [
    '2025年5月4日',
    '新服务器的构想',
    'Neko 和 cyh2 在 EternalStar 聊起了新服务器的想法，Voidix 这个名字也在那时定了下来。',
  ],
  ['2025年5月10日', 'Voidix开始搭建', 'Voidix 开始搭建。我们重新整理了服务器的结构，希望把以前遇到的问题一一解决。'],
  [
    '2025年5月11日',
    '新老交替',
    'Voidix 接替 VBPIXEL。服务器继续保持公益、免费，也希望大家能在这里好好玩游戏。',
    'Voidix将带着这些理念，继续走下去。',
  ],
  ['2025年5月13日', '官网建设', '官网开始搭建，先把服务器的玩法、加入方法和规则说明白。'],
  ['2025年7月1日', 'Voidix正式启航', 'Voidix 正式开放，欢迎第一批玩家进来。'],
];
---

<section class="px-5 py-16 sm:px-6 sm:py-24" id="timeline">
  <div class="mx-auto max-w-6xl border-t border-white/10 pt-12 sm:pt-20">
    <div class="max-w-2xl">
      <h2 class="text-[42px] font-semibold leading-[1.1] text-white" data-motion="fade-up">我们是怎么走到这里的</h2>
      <p class="mt-5 text-[17px] leading-7 text-gray-400" data-motion="fade-up" style="--motion-delay: 80ms">
        从 VBPIXEL 到 Voidix，留下了这些时间点。
      </p>
    </div>

    <div class="mt-12 border-t border-white/10">
      {
        events.map(([date, title, description, additionalDescription], index) => (
          <article
            class="grid gap-3 border-b border-white/10 py-7 sm:grid-cols-[180px_1fr] sm:gap-10"
            data-motion={index % 2 ? 'fade-left' : 'fade-right'}
          >
            <time class="text-sm text-gray-500">{date}</time>
            <div>
              <h3 class="text-lg font-medium text-white">{title}</h3>
              <p class="mt-3 max-w-3xl text-[15px] leading-7 text-gray-400">{description}</p>
              {additionalDescription && <p class="mt-3 text-[15px] leading-7 text-gray-300">{additionalDescription}</p>}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
