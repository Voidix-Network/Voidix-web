---
import LucideIcon from '../LucideIcon.astro';
---

<section
  class="relative flex flex-col select-none px-6 min-[976px]:min-h-[min(calc(100svh-var(--header-height)),1100px)]"
  style="--header-height: 64px"
  data-realtime
>
  <div class="relative mx-auto flex min-h-[min(calc(100svh-var(--header-height)),1100px)] w-full max-w-[1400px] flex-none flex-col justify-center min-[976px]:min-h-0 min-[976px]:flex-1">
    <div class="relative flex min-h-0 flex-1 flex-col items-center justify-center pb-[2.5em] min-[976px]:flex-row min-[976px]:items-center min-[976px]:justify-between min-[976px]:gap-0 min-[976px]:py-[2.5em]">
      <div class="pointer-events-none relative z-0 flex min-h-0 min-w-0 flex-1 w-full min-[976px]:absolute min-[976px]:inset-0 min-[976px]:flex-none min-[976px]:w-auto">
        <div class="absolute left-1/2 top-1/2 aspect-[3/2] h-[min(125vw,400px)] max-w-[100vw] -translate-x-1/2 -translate-y-1/2 min-[768px]:h-[min(100vw,650px)] min-[976px]:h-full min-[976px]:max-h-[560px] min-[976px]:w-auto min-[976px]:max-w-[min(1080px,100vw)]">
          <figure class="absolute inset-0 flex items-center justify-center">
            <img
              src="/logo.svg"
              alt="Voidix"
              class="block h-[clamp(300px,82vw,360px)] w-auto max-w-none min-[768px]:h-[clamp(300px,100vw,650px)] min-[976px]:h-[clamp(300px,calc(75vw-645px),400px)]"
            />
          </figure>
        </div>
      </div>

      <header class="relative z-10 order-2 mx-auto flex w-full max-w-[444px] flex-col items-center gap-4 text-center min-[976px]:order-none min-[976px]:mx-0 min-[976px]:items-start min-[976px]:gap-8 min-[976px]:text-left" data-motion="fade-up">
        <p class="hidden text-[15px] font-medium text-gray-400 min-[976px]:block">公平至上的Minecraft体验</p>
        <h1 class="text-[48px] font-normal leading-[56px] tracking-[-0.06em] text-white min-[480px]:text-[64px] min-[480px]:leading-[64px] min-[976px]:!text-[64px] min-[976px]:!leading-[64px]">下一代<br />公益服务器</h1>
        <p class="relative min-h-6 w-full max-w-sm text-center font-mono text-base leading-6 text-gray-400 min-[976px]:hidden" data-hero-scramble aria-live="polite">
          <span class="invisible" aria-hidden="true" data-hero-scramble-measure>继承VBPIXEL和EternalStar精神的公益小游戏服务器</span>
          <span class="absolute inset-0" data-hero-scramble-output>公平至上的Minecraft体验</span>
        </p>
        <div class="mt-3 flex w-full flex-col items-center justify-center gap-3 min-[640px]:flex-row min-[768px]:w-min min-[976px]:mt-0 min-[976px]:items-start min-[976px]:justify-start">
          <a href="#versions" class="inline-flex h-10 w-full shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-full bg-[#6a93ff] px-3 text-base font-medium text-[#08090a] transition-colors hover:bg-[#7367f0] min-[640px]:w-auto">加入方式<LucideIcon name="external-link" class="h-4 w-4" /></a>
          <a href="/status/" class="inline-flex h-10 w-full shrink-0 items-center justify-center whitespace-nowrap rounded-full border border-white/15 px-3 text-base font-medium text-gray-200 transition-colors hover:border-white/30 hover:bg-white/5 hover:text-white min-[640px]:w-auto">服务器状态</a>
        </div>
      </header>

      <div class="relative z-10 order-3 mt-7 hidden w-full max-w-[301px] text-center text-[17px] leading-7 text-gray-400 min-[976px]:order-none min-[976px]:mx-0 min-[976px]:mt-0 min-[976px]:block min-[976px]:text-left" data-motion="fade-up" style="--motion-delay: 140ms">
        <p>由开发者NekoSora和CYAN-HEX创建</p>
        <p class="mt-1">继承VBPIXEL和EternalStar精神的公益小游戏服务器</p>
      </div>
    </div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-6xl shrink-0 pb-10 pt-6" data-motion="fade-up" style="--motion-delay: 280ms">
    <div class="mb-4 flex items-center justify-between px-1"><h2 class="text-sm font-medium text-white">服务器</h2><span class="text-xs text-gray-500">实时状态</span></div>
    <div class="grid gap-3 md:grid-cols-2">
      <article class="min-w-0 border border-white/10 bg-[#0d0d0f] px-5 py-5 sm:px-6"><div class="flex items-center justify-between gap-4"><div class="flex min-w-0 items-center gap-2 text-sm font-medium text-white"><span class="h-2 w-2 shrink-0 rounded-full bg-red-500" data-minigame-hero-dot></span>小游戏</div><div class="flex shrink-0 items-center gap-2 text-sm text-red-400"><span data-minigame-status>获取中...</span><div class="relative" hidden data-minigame-status-note><div class="group relative"><span class="flex h-5 w-5 cursor-help items-center justify-center rounded-full border border-yellow-500/40 text-xs font-bold text-yellow-400">?</span><div class="pointer-events-none absolute bottom-full right-0 z-10 mb-2 w-48 border border-white/10 bg-[#171719] px-3 py-2 text-left text-xs leading-5 text-gray-300 opacity-0 shadow-xl transition-opacity group-hover:pointer-events-auto group-hover:opacity-100">实时状态查询服务仅在中国大陆网络提供</div></div></div></div></div><div class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="font-mono text-sm text-gray-200">minigame.voidix.net</span><span class="text-xs text-gray-500">Java 26.1–26.1.2</span></div></article>
      <article class="min-w-0 border border-white/10 bg-[#0d0d0f] px-5 py-5 sm:px-6"><div class="flex items-center justify-between gap-4"><div class="flex min-w-0 items-center gap-2 text-sm font-medium text-white"><span class="h-2 w-2 shrink-0 rounded-full bg-yellow-500"></span>生存</div><div class="group relative flex shrink-0 items-center gap-2 text-sm text-yellow-400"><span>状态系统维护</span><span class="flex h-5 w-5 cursor-help items-center justify-center rounded-full border border-yellow-500/40 text-xs font-bold">?</span><div class="pointer-events-none absolute bottom-full right-0 z-10 mb-2 w-52 border border-white/10 bg-[#171719] px-3 py-2 text-left text-xs leading-5 text-gray-300 opacity-0 shadow-xl transition-opacity group-hover:pointer-events-auto group-hover:opacity-100">生存服状态查询系统当前正在维护，建议您进入游戏检查生存服状态</div></div></div><div class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="font-mono text-sm text-gray-200">survival.voidix.net</span><span class="text-xs text-gray-500">Java 1.7.2–最新</span></div></article>
    </div>
    <a href="https://geysermc.org/wiki/geyser/" class="mt-3 flex items-center gap-2 border border-white/10 px-5 py-3 text-xs text-gray-500 transition-colors hover:bg-white/[0.03] hover:text-gray-300 sm:px-6"><LucideIcon name="check" class="h-4 w-4 text-green-400" />基岩版可加入<LucideIcon name="external-link" class="ml-auto h-3.5 w-3.5" /></a>
  </div>
</section>
