---
import LucideIcon from '../LucideIcon.astro';
---

<section class="px-5 pb-16 pt-16 sm:px-6 sm:pb-24 sm:pt-24" data-realtime>
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-[15px] font-medium text-gray-400" data-motion="fade-up">公平至上的Minecraft体验</p>
      <h1
        class="mt-5 text-[52px] font-semibold leading-[1.08] text-white"
        data-motion="fade-up"
        style="--motion-delay: 80ms"
      >
        下一代 公益服务器
      </h1>
      <div class="mt-6 text-[17px] leading-7 text-gray-400" data-motion="fade-up" style="--motion-delay: 140ms">
        <p>由开发者NekoSora和CYAN-HEX创建</p>
        <p>继承VBPIXEL和EternalStar精神的公益小游戏服务器</p>
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3" data-motion="fade-up" style="--motion-delay: 200ms">
        <a
          href="#versions"
          class="inline-flex h-10 items-center gap-2 rounded-full bg-[#6a93ff] px-5 text-sm font-medium text-[#08090a] transition-colors hover:bg-[#7367f0]"
        >
          查看加入方法
          <LucideIcon name="external-link" class="h-4 w-4" />
        </a>
        <a
          href="/status/"
          class="inline-flex h-10 items-center rounded-full border border-white/15 px-5 text-sm font-medium text-gray-200 transition-colors hover:border-white/30 hover:bg-white/5 hover:text-white"
        >
          查看服务器状态
        </a>
      </div>
    </div>

    <div class="mt-12" data-motion="fade-up" style="--motion-delay: 280ms">
      <div class="mb-4 flex items-center justify-between px-1">
        <h2 class="text-sm font-medium text-white">服务器</h2>
        <span class="text-xs text-gray-500">实时状态</span>
      </div>

      <div class="overflow-hidden rounded-xl border border-white/10 bg-[#0d0d0f]">
        <div class="grid gap-4 border-b border-white/10 px-5 py-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:px-6">
          <div class="min-w-0">
            <div class="flex items-center gap-2 text-sm font-medium text-white">
              <span class="h-2 w-2 shrink-0 rounded-full bg-red-500" data-minigame-hero-dot></span>
              小游戏
            </div>
            <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="font-mono text-sm text-gray-200">minigame.voidix.net</span>
              <span class="text-xs text-gray-500">Java 26.1–26.1.2</span>
            </div>
          </div>
          <div class="flex items-center gap-2 text-sm font-medium text-red-400">
            <span data-minigame-status>获取中...</span>
            <div class="relative" hidden data-minigame-status-note>
              <div class="group relative">
                <span class="flex h-5 w-5 cursor-help items-center justify-center rounded-full border border-yellow-500/40 text-xs font-bold text-yellow-400">?</span>
                <div class="pointer-events-none absolute bottom-full right-0 z-10 mb-2 w-48 rounded-lg border border-white/10 bg-[#171719] px-3 py-2 text-left text-xs leading-5 text-gray-300 opacity-0 shadow-xl transition-opacity group-hover:pointer-events-auto group-hover:opacity-100">
                  实时状态查询服务仅在中国大陆网络提供
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid gap-4 px-5 py-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:px-6">
          <div class="min-w-0">
            <div class="flex items-center gap-2 text-sm font-medium text-white">
              <span class="h-2 w-2 shrink-0 rounded-full bg-yellow-500"></span>
              生存
            </div>
            <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="font-mono text-sm text-gray-200">survival.voidix.net</span>
              <span class="text-xs text-gray-500">Java 1.7.2–最新</span>
            </div>
          </div>
          <div class="group relative flex items-center gap-2 text-sm font-medium text-yellow-400">
            <span>状态系统维护</span>
            <span class="flex h-5 w-5 cursor-help items-center justify-center rounded-full border border-yellow-500/40 text-xs font-bold">?</span>
            <div class="pointer-events-none absolute bottom-full right-0 z-10 mb-2 w-52 rounded-lg border border-white/10 bg-[#171719] px-3 py-2 text-left text-xs leading-5 text-gray-300 opacity-0 shadow-xl transition-opacity group-hover:pointer-events-auto group-hover:opacity-100">
              生存服状态查询系统当前正在维护，建议您进入游戏检查生存服状态
            </div>
          </div>
        </div>

        <a
          href="https://geysermc.org/wiki/geyser/"
          class="flex items-center gap-2 border-t border-white/10 px-5 py-3 text-xs text-gray-500 transition-colors hover:bg-white/[0.03] hover:text-gray-300 sm:px-6"
        >
          <LucideIcon name="check" class="h-4 w-4 text-green-400" />
          基岩版可加入
          <LucideIcon name="external-link" class="ml-auto h-3.5 w-3.5" />
        </a>
      </div>
    </div>
  </div>
</section>
