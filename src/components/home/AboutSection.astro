---

---

<section class="mb-32 scroll-mt-32 2xl:mb-24" id="about">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 2xl:py-16">
    <div class="flex flex-col items-center gap-8 md:flex-row md:gap-12">
      <div class="md:w-1/2">
        <div data-motion="fade-left" style="--motion-distance: 20px">
          <h2 class="mb-6 text-3xl font-bold">
            关于<span class="ml-2"><span class="gradient-text font-bold font-sans">Voidix</span></span>
          </h2>
          <p class="mb-6 text-gray-400">
            Voidix是一个由开发者NekoSora和CYsonHab创建的公益小游戏Minecraft服务器，继承VBPIXEL和EternalStar的精神。我们坚持无商业化运营，致力于为所有玩家提供公平与和谐的游戏环境。
          </p>

          <div class="mt-6 hidden grid-cols-3 gap-3 sm:grid">
            <div
              class="rounded-lg border border-[#2a365c] bg-[#1a1f2e] px-4 py-3 transition-colors duration-200 hover:bg-[#1f2538]/60"
            >
              <div class="mb-1 whitespace-nowrap text-xs text-gray-400">在线玩家</div>
              <div class="text-center text-base font-bold text-white" data-total-players>0人</div>
            </div>
            <div
              class="rounded-lg border border-[#2a365c] bg-[#1a1f2e] px-4 py-3 transition-colors duration-200 hover:bg-[#1f2538]/60"
            >
              <div class="mb-1 whitespace-nowrap text-xs text-gray-400">运行时间</div>
              <div
                class="flex items-center justify-center whitespace-nowrap text-base font-bold text-white"
                data-current-uptime
              >
                0分
              </div>
            </div>
            <div
              class="rounded-lg border border-[#2a365c] bg-[#1a1f2e] px-4 py-3 transition-colors duration-200 hover:bg-[#1f2538]/60"
            >
              <div class="mb-1 whitespace-nowrap text-xs text-gray-400">总运行时长</div>
              <div
                class="flex items-center justify-center whitespace-nowrap text-base font-bold text-white"
                data-total-uptime
              >
                0分
              </div>
            </div>
          </div>

          <div class="mt-6 grid grid-cols-3 gap-2 sm:hidden">
            <div class="rounded-lg border border-[#2a365c] bg-[#1a1f2e] px-3 py-3">
              <div class="mb-1 text-center text-xs text-gray-400">在线玩家</div>
              <div
                class="flex items-center justify-center whitespace-nowrap text-base font-bold text-white"
                data-total-players
              >
                0人
              </div>
            </div>
            <div class="rounded-lg border border-[#2a365c] bg-[#1a1f2e] px-3 py-3">
              <div class="mb-1 text-center text-xs text-gray-400">运行时间</div>
              <div
                class="flex items-center justify-center whitespace-nowrap text-base font-bold text-white"
                data-current-uptime
              >
                0分
              </div>
            </div>
            <div class="rounded-lg border border-[#2a365c] bg-[#1a1f2e] px-3 py-3">
              <div class="mb-1 text-center text-xs text-gray-400">总运行时间</div>
              <div
                class="flex items-center justify-center whitespace-nowrap text-base font-bold text-white"
                data-total-uptime
              >
                0分
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="relative mt-10 md:mt-0 md:w-1/2">
        <div data-motion="fade-right" style="--motion-distance: 20px">
          <div class="absolute -left-8 -top-8 h-32 w-32 rounded-full bg-blue-600 opacity-20 blur-3xl"></div>
          <div class="absolute -bottom-8 -right-8 h-32 w-32 rounded-full bg-indigo-600 opacity-20 blur-3xl"></div>
          <div class="relative rounded-2xl border border-[#2a365c] bg-[#1a1f2e]/50 p-6 backdrop-blur-sm md:p-8">
            <h3 class="mb-5 text-center text-xl font-bold md:text-left">服务器状态</h3>
            <div class="space-y-4">
              <div class="rounded-lg border border-[#2a365c]/70 bg-[#151b2d]/80 px-5 py-4">
                <div class="flex items-center justify-between">
                  <div class="mr-3 flex flex-shrink items-center gap-3">
                    <div
                      class="h-4 w-4 flex-shrink-0 rounded-full bg-red-500"
                      id="minigame-status-dot-desktop"
                      data-minigame-about-dot
                    >
                    </div>
                    <span class="text-sm font-medium text-gray-200 md:text-base">小游戏服务器</span>
                  </div>
                  <div
                    class="min-w-[70px] flex-shrink-0 whitespace-nowrap text-right font-mono text-sm font-semibold text-red-400 md:text-base"
                    id="minigame-status-badge-desktop"
                    data-minigame-summary
                  >
                    连接失败
                  </div>
                </div>
              </div>

              <div class="rounded-lg border border-[#2a365c]/70 bg-[#151b2d]/80 px-5 py-4">
                <div class="flex items-center justify-between">
                  <div class="mr-3 flex flex-shrink items-center gap-3">
                    <div
                      class="h-4 w-4 flex-shrink-0 animate-pulse rounded-full bg-yellow-500"
                      id="survival-status-dot-desktop"
                    >
                    </div>
                    <span class="text-sm font-medium text-gray-200 md:text-base">生存服务器</span>
                  </div>
                  <div
                    class="min-w-[70px] flex-shrink-0 whitespace-nowrap text-right font-mono text-sm font-semibold text-yellow-400 md:text-base"
                    id="survival-status-badge-desktop"
                    data-survival-summary
                  >
                    连接失败
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-6 text-center">
              <a
                href="/status"
                class="inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-indigo-700"
              >
                查看完整状态
                <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
