---
import { navigation } from '../data/site';
---

<nav
  class="fixed z-50 w-full border-b border-transparent bg-[#08090a]/90 backdrop-blur-xl transition-colors duration-200"
  data-site-header
>
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="flex h-[72px] items-center justify-between">
      <div class="flex items-center">
        <button class="cursor-pointer focus:outline-none" data-nav-target="/">
          <span class="font-sans text-[21px] font-semibold text-white">Voidix</span>
        </button>
      </div>

      <div class="hidden items-center gap-1 lg:flex">
        {
          navigation.map((item) => (
            <button
              class="cursor-pointer whitespace-nowrap rounded-full px-3 py-2 text-[13px] font-medium text-gray-400 transition-colors hover:text-white"
              data-nav-target={item.href}
            >
              {item.label}
            </button>
          ))
        }
      </div>

      <div class="flex items-center lg:hidden">
        <button
          class="cursor-pointer rounded-full p-2 text-gray-300 hover:text-white focus:outline-none lg:hidden"
          data-mobile-menu-button
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="sr-only">打开主菜单</span>
          <svg
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            data-mobile-menu-icon><path data-mobile-menu-icon-path d="M4 6h16M4 12h16M4 18h16"></path></svg
          >
        </button>
      </div>
    </div>
  </div>

  <div class="overflow-hidden border-t border-white/10 bg-[#08090a] lg:hidden" id="mobile-menu" data-mobile-menu>
    <div class="max-h-[70vh] space-y-1 overflow-y-auto px-2 pb-3 pt-2 sm:px-3">
      {
        navigation.map((item) => (
          <button
            class="block w-full cursor-pointer rounded-lg px-3 py-2 text-left text-base font-medium text-gray-300 transition-colors hover:bg-white/5 hover:text-white"
            data-nav-target={item.href}
          >
            {item.label}
          </button>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
  let headerFrame = 0;
  const syncHeaderBoundary = () => {
    headerFrame = 0;
    siteHeader?.toggleAttribute('data-scrolled', window.scrollY > 0);
  };
  const onHeaderScroll = () => {
    if (!headerFrame) headerFrame = window.requestAnimationFrame(syncHeaderBoundary);
  };
  syncHeaderBoundary();
  window.addEventListener('scroll', onHeaderScroll, { passive: true });

  const button = document.querySelector<HTMLButtonElement>('[data-mobile-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  button?.addEventListener('click', () => {
    if (!menu) return;
    const open = !menu.hasAttribute('data-open');
    menu.toggleAttribute('data-open', open);
    const icon = button.querySelector<SVGElement>('[data-mobile-menu-icon]');
    const path = button.querySelector<SVGPathElement>('[data-mobile-menu-icon-path]');
    if (icon) icon.style.transform = open ? 'rotate(90deg)' : 'rotate(0deg)';
    if (path) path.setAttribute('d', open ? 'M18 6 6 18M6 6l12 12' : 'M4 6h16M4 12h16M4 18h16');
    button.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll<HTMLButtonElement>('[data-nav-target]').forEach((target) =>
    target.addEventListener('click', () => {
      if (menu) menu.removeAttribute('data-open');
      window.location.href = target.dataset.navTarget || '/';
    }),
  );
</script>
